DJANGO_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=tu-app.onrender.com,tu-dominio.com,www.tu-dominio.com
DJANGO_CSRF_TRUSTED_ORIGINS=tu-app.onrender.com,tu-dominio.com,www.tu-dominio.com
DJANGO_TIME_ZONE=America/Tegucigalpa

# Render PostgreSQL. Si Render te da DATABASE_URL, no necesitas POSTGRES_* en Render.
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_base

# PostgreSQL local recomendado para Electron/oficina:
DJANGO_DB_ENGINE=postgresql
POSTGRES_NAME=NombreBase
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=usuario
POSTGRES_PASSWORD=password

# Opcional: fuerza una base local distinta solo para Electron.
# Si no defines estos valores, Electron usa DJANGO_DB_ENGINE y POSTGRES_*.
# ELECTRON_DB_ENGINE=postgresql
# ELECTRON_POSTGRES_NAME=NombreBaseLocal
# ELECTRON_POSTGRES_HOST=127.0.0.1
# ELECTRON_POSTGRES_PORT=5432
# ELECTRON_POSTGRES_USER=usuario
# ELECTRON_POSTGRES_PASSWORD=password

# MySQL Server recomendado para produccion:
MYSQL_NAME=NombreBase
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=usuario
MYSQL_PASSWORD=password
MYSQL_CHARSET=utf8mb4

# SQLite queda solo para desarrollo local:
# DJANGO_DB_ENGINE=sqlite
# SQLITE_NAME=db.sqlite3
# ELECTRON_DB_ENGINE=sqlite
# ELECTRON_SQLITE_NAME=local.sqlite3

# Si usaras Microsoft SQL Server, cambia DJANGO_DB_ENGINE=sqlserver y completa:
# SQLSERVER_NAME=NombreBase
# SQLSERVER_HOST=servidor\\instancia
# SQLSERVER_PORT=
# SQLSERVER_USER=
# SQLSERVER_PASSWORD=
# SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server

DJANGO_USE_PROXY_SSL_HEADER=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true

# Bootstrap de acceso inicial
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=superadmin@tu-dominio.com
SUPERADMIN_PASSWORD=change-me-now

# Sincronizacion Render <-> Electron local
SYNC_API_TOKEN=change-me-with-a-long-random-sync-token
SYNC_REMOTE_URL=https://tu-app.onrender.com
SYNC_INTERVAL_SECONDS=300
SYNC_RETRY_SECONDS=30
SYNC_DEBOUNCE_SECONDS=5
SYNC_CONNECTIVITY_TIMEOUT_SECONDS=10
SYNC_BATCH_SIZE=250
SYNC_PULL_BATCH_SIZE=500
SYNC_LOCK_TTL_SECONDS=900
