DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Por defecto usa SQLite dentro de un volumen Docker.
DJANGO_DB_ENGINE=sqlite
SQLITE_NAME=/app/data/db.sqlite3

# Para SQL Server externo:
# DJANGO_DB_ENGINE=sqlserver
# SQLSERVER_NAME=NombreBase
# SQLSERVER_HOST=host.docker.internal
# SQLSERVER_PORT=1433
# SQLSERVER_USER=usuario
# SQLSERVER_PASSWORD=password
# SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server

SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=admin12345
